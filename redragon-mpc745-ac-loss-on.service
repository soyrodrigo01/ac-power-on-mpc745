[Unit]
Description=Arm REDRAGON MPC745 automatic power-on after AC loss
Documentation=file:/home/jose/bios-research/pmio-read/FINDINGS.md
After=local-fs.target
Before=multi-user.target
ConditionPathExists=/dev/mem
ConditionPathExists=/sys/class/dmi/id/board_name

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/redragon-mpc745-ac-loss-on
RemainAfterExit=yes
Restart=no
TimeoutStartSec=15
User=root
Group=root
CapabilityBoundingSet=CAP_SYS_RAWIO
NoNewPrivileges=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/mem rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
